# ---------------------------------------------------------------------------
# Products page (Advertised products) -> powerbidb.Products
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds secrets: never commit it. Exported environment variables take
# precedence over values in this file.
# ---------------------------------------------------------------------------

# --- MySQL (destination is fixed: powerbidb.Products) ------------------------
DB_HOST=db.example.internal
DB_PORT=3306
# Must be powerbidb; any other value is refused.
DB_NAME=powerbidb
DB_USER=powerbi_user
DB_PASSWORD=change-me
# How dates are written when the Date column is TEXT/VARCHAR. Ignored for
# DATE / DATETIME columns. The manual script wrote 2026-10-28, i.e. %Y-%m-%d.
DB_DATE_FORMAT=%Y-%m-%d
# DB_SSL_CA=certs/isrgrootx1.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30

# --- Dates -------------------------------------------------------------------
# The Amazon advertiser account's timezone: the calendar the Today / Yesterday
# presets follow, and so the date each load is stored under. US marketplace
# accounts report in America/Los_Angeles (the manual script used US/Pacific).
AMAZON_ACCOUNT_TIMEZONE=America/Los_Angeles
# Your own timezone; only used to show local time in the logs.
REPORT_TIMEZONE=Asia/Kolkata

# --- Products page -----------------------------------------------------------
# Advertiser account: the entityId=... value in the Products page URL
# (https://advertising.amazon.com/cm/products?entityId=ENTITY...).
AMAZON_ENTITY_ID=ENTITYXXXXXXXXXXXX
# Optional override; {entity_id} is filled in.
# PRODUCTS_URL_TEMPLATE=https://advertising.amazon.com/cm/products?entityId={entity_id}
# Text the page must show before anything is exported: the filter the data has
# always been loaded with. Leave empty to skip the check.
REQUIRED_FILTER_TEXT=Clicks: greater than 0
# "Results per page" chosen before exporting: 25, 50, 100 or 200.
RESULTS_PER_PAGE=200
# Safety stop for the page loop (200 x 50 = 10,000 products).
MAX_PAGES=50

# --- Amazon sign-in ----------------------------------------------------------
# Sign in ONCE on the machine that runs cron:   python run.py login
# It fills in this email/password, asks you for Amazon's OTP in the terminal,
# ticks "don't ask for a code on this browser" and saves the session in
# SESSION_DIR. Every scheduled run reuses that session; if it lapses, the run
# signs in again with these credentials (no OTP on the trusted browser).
AMAZON_EMAIL=itrendsolution196@gmail.com
AMAZON_PASSWORD=Itrend@12345
AMAZON_AUTO_LOGIN=true

# --- Files -------------------------------------------------------------------
REPORTS_DIR=data/reports
DOWNLOAD_DIR=data/downloads
ARCHIVE_DIR=data/archive
FAILED_DIR=data/failed
SCREENSHOT_DIR=data/screenshots
LOG_DIR=logs
# Chromium profile with the Amazon session. Treat it as a credential.
# Keep it separate from other projects' sessions: two jobs must never open the
# same profile at the same time.
SESSION_DIR=data/session
LOCK_FILE=data/products_report.lock

# --- Browser and waiting -----------------------------------------------------
HEADLESS=true
# Optional. 'login' and the scheduled runs both use headless Chromium, so the
# browser Amazon trusted at login is the one cron uses. Only set this if you
# want a fixed identity, and then never change it (Amazon would ask for an OTP).
# BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36
BROWSER_TIMEOUT_MS=60000
# How long one page's Export may take to produce its file.
DOWNLOAD_TIMEOUT_MS=120000
# Set to true when the job runs as root on the server.
BROWSER_NO_SANDBOX=false

# --- Retry -------------------------------------------------------------------
# Transient failures only (navigation, download, an export that does not add
# up, lost DB connection). Authentication is never retried.
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=10
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping --------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# Age at which the app deletes its OWN downloads, archives and screenshots.
FILE_RETENTION_DAYS=7
